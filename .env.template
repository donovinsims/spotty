# podcast-transcriber configuration
# =================================
# Copy this file to `.env` (scripts/install.sh does this automatically when
# `.env` is missing) and adjust.  `.env` is git-ignored and is loaded at
# startup from the repo root, so `pt` works from any CWD.
#
# Every key is optional; commented defaults are used when a key is absent.

# --- Web UI ------------------------------------------------------------
# Bind address for `pt serve`.  Keep 127.0.0.1 for local-only use; when
# exposing over Tailscale, leave this as 127.0.0.1 and run
# scripts/tailscale-serve.sh (which proxies the tailnet to localhost).
PT_HOST=127.0.0.1

# Web UI port (default 8765).  Used by `pt serve` and the ops scripts.
PT_PORT=8765

# Optional single-user auth token.  EMPTY = no auth (current single-user LAN
# behaviour).  When set, every route except /healthz and /static/* requires
# the token, accepted as `Authorization: Bearer <token>`, `?token=<token>`,
# or the `pt_token` cookie set by the /login page.  Generate one with:
#   openssl rand -hex 32
PT_AUTH_TOKEN=

# --- Transcription ------------------------------------------------------
# MLX Whisper model used for transcription (downloaded on first use into
# ~/.cache/huggingface).
PT_MODEL=mlx-community/whisper-small-mlx

# Data directory (SQLite DB, downloaded audio, cache), relative to the repo
# root when `pt` runs from the repo.
PT_DATA_DIR=data

# Maximum bytes accepted when downloading an episode's audio (1 GiB default).
PT_MAX_DOWNLOAD_BYTES=1073741824

# Seconds the web worker waits for an in-flight job to stop on shutdown
# before marking it FAILED so the single-active-job slot never deadlocks.
PT_WORKER_STOP_TIMEOUT=5

# --- Phase 1 tuning (optional) -----------------------------------------
# Duration of each transcription chunk, in minutes.
PT_CHUNK_MINUTES=10

# iTunes Search API result limit during resolution.
PT_TOP_RESULTS=25

# Episode-match duration tolerance, in seconds.
PT_DURATION_TOLERANCE=600
